<odoo>
    <record id="product_template_form_view_havsh" model="ir.ui.view">
        <field name="name">product.template.form.havsh</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_subscription.product_template_form_view_sale_subscription"/>
        <field name="arch" type="xml">
            <field name="recurring_invoice" position="after">
                <field name="havsh_provisioning_template_id"
                       invisible="not recurring_invoice"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
