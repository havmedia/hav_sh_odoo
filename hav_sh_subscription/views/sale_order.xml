<odoo>
    <record id="sale_subscription_primary_form_view_havsh" model="ir.ui.view">
        <field name="name">sale.order.form.havsh.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_primary_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_show_havsh_odoo_instances" type="object"
                        class="oe_stat_button" icon="fa-server"
                        invisible="havsh_odoo_count == 0">
                    <div class="o_stat_info">
                        <field name="havsh_odoo_count" class="o_stat_value"/>
                        <span class="o_stat_text" invisible="havsh_odoo_count &lt; 2">HAV.sh Instances</span>
                        <span class="o_stat_text" invisible="havsh_odoo_count &gt; 1">HAV.sh Instance</span>
                    </div>
                </button>
                <button name="action_show_havsh_provisioning_jobs" type="object"
                        class="oe_stat_button" icon="fa-cogs"
                        invisible="havsh_provisioning_job_count == 0">
                    <div class="o_stat_info">
                        <field name="havsh_provisioning_job_count" class="o_stat_value"/>
                        <span class="o_stat_text" invisible="havsh_provisioning_job_count &lt; 2">Provisioning Jobs</span>
                        <span class="o_stat_text" invisible="havsh_provisioning_job_count &gt; 1">Provisioning Job</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
