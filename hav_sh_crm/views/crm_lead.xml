<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.havsh</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_show_havsh_odoo_systems" type="object" class="oe_stat_button" icon="fa-server">
                    <div class="o_stat_info">
                        <field name="havsh_odoo_system_count" class="o_stat_value"/>
                        <span class="o_stat_text" invisible="havsh_odoo_system_count &lt; 2">Demo Systems</span>
                        <span class="o_stat_text" invisible="havsh_odoo_system_count &gt; 1">Demo System</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
