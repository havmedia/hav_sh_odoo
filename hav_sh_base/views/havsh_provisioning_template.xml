<odoo>
    <record id="action_havsh_provisioning_templates" model="ir.actions.act_window">
        <field name="name">Provisioning Templates</field>
        <field name="res_model">havsh.provisioning.template</field>
        <field name="view_mode">list,form</field>
        <field name="path">havsh-provisioning-templates</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No provisioning templates synced yet. Use "Fetch Templates" to sync from HAV.sh.
            </p>
        </field>
    </record>

    <record id="view_havsh_provisioning_template_list" model="ir.ui.view">
        <field name="name">havsh.provisioning.template.list</field>
        <field name="model">havsh.provisioning.template</field>
        <field name="arch" type="xml">
            <list string="Provisioning Templates">
                <field name="name"/>
                <field name="odoo_version"/>
                <field name="odoo_type"/>
                <field name="cloud_location"/>
                <field name="cloud_server_type"/>
                <field name="last_synced_at"/>
            </list>
        </field>
    </record>

    <record id="view_havsh_provisioning_template_form" model="ir.ui.view">
        <field name="name">havsh.provisioning.template.form</field>
        <field name="model">havsh.provisioning.template</field>
        <field name="arch" type="xml">
            <form string="Provisioning Template" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="odoo_version"/>
                            <field name="odoo_type"/>
                            <field name="cloud_location"/>
                            <field name="cloud_server_type"/>
                        </group>
                        <group>
                            <field name="external_id" groups="base.group_no_one"/>
                            <field name="uuid" groups="base.group_no_one"/>
                            <field name="last_synced_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
